# ==============================================================================
# CampusOS Environment Configuration Template
# Copy this file to .env and adjust the values for your deployment.
# ==============================================================================

# Database Connection (PostgreSQL)
# Local Docker Compose defaults to: postgres://campus_admin:campus_secret_password@localhost:5432/campus_os
DATABASE_URL=postgres://campus_admin:campus_secret_password@localhost:5432/campus_os

# Database Credentials (used by Docker Compose postgres service)
POSTGRES_USER=campus_admin
POSTGRES_PASSWORD=campus_secret_password
POSTGRES_DB=campus_os
POSTGRES_PORT=5432

# Backend API Server Configuration
PORT=5000
API_PORT=5000
NODE_ENV=development

# Web Frontend Configuration
WEB_PORT=8080
BASE_PATH=/
API_TARGET=http://localhost:5000

# Mobile / Expo Configuration
APP_DOMAIN=localhost
EXPO_PUBLIC_DOMAIN=localhost
