{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "build:web": "pnpm --filter @workspace/campus-os-web run build",
    "build:next": "pnpm --filter campus-os-nextjs run build",
    "build:api": "pnpm --filter @workspace/api-server run build",
    "dev:web": "pnpm --filter @workspace/campus-os-web run dev",
    "dev:next": "pnpm --filter campus-os-nextjs run dev",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "start:web": "pnpm --filter @workspace/campus-os-web run serve",
    "start:api": "pnpm --filter @workspace/api-server run start",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
