# ==============================================================================
# Build Stage
# ==============================================================================
FROM node:22-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy workspace package manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY artifacts/campus-os-web/package.json ./artifacts/campus-os-web/
COPY lib/api-client-react/package.json ./lib/api-client-react/
COPY lib/api-spec/package.json ./lib/api-spec/
COPY lib/api-zod/package.json ./lib/api-zod/
COPY lib/db/package.json ./lib/db/
COPY tsconfig.base.json tsconfig.json ./

# Install workspace dependencies
RUN pnpm install --frozen-lockfile

# Copy library source and build
COPY lib/ ./lib/
RUN pnpm --filter @workspace/api-client-react run typecheck || true

# Copy web source and build
COPY artifacts/campus-os-web/ ./artifacts/campus-os-web/
RUN pnpm --filter @workspace/campus-os-web run build

# ==============================================================================
# Production Stage
# ==============================================================================
FROM nginx:alpine

COPY --from=builder /app/artifacts/campus-os-web/dist/public /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
